# Exemple simplifié et générique
# Construction multi-étapes d'une API ASP.NET Core 8, exécutée sans privilèges root.
# Aucun secret dans l'image : la configuration sensible vient de l'hébergeur au démarrage.

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY MonApi.csproj .
RUN dotnet restore
COPY . .
RUN dotnet publish -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
USER app
ENTRYPOINT ["dotnet", "MonApi.dll"]
